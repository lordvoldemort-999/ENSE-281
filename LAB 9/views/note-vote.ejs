<%- include("layouts/header.ejs") -%>
    <div class="container px-5 py-5">
      <h1>Note-Vote</h1>
      <div class="accordion shadow" id="accordion">
        <div class="accordion-item">
          <h2 class="accordion-header">
            <button
              class="accordion-button"
              data-bs-toggle="collapse"
              data-bs-target="#collapseOne"
              aria-expanded="true"
              aria-controls="collapseOne"
              type="button"
              value="logged-in"
              id="logged-in-as"
            >Logged in as <%= username %>
            </button>
          </h2>
          <div
            id="collapseOne"
            class="accordion-collapse collapse show add-padding"
            data-bs-parent="#accordion"
          >
            <div class="accordion-body">
              <div class="to-center">
                <div class="dropdown">
                  <button
                    class="btn btn-primary dropdown-toggle"
                    type="button"
                    id="switch-user"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                  >
                    Switch User
                  </button>

                  <div id="user-dropdown" class="dropdown-menu">
                    <% for (let user of users) { %>
                        <form action="/switch-user" method="POST">
                        <input type="hidden" name="newUsername" value="<%= user.username %>" />
                        <button type="submit" class="dropdown-item"><%= user.username %></button>
                        </form>
                    <% } %>
                </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="spacer"></div>
      <div class="container-sm">
        <div class="note-div" id="note-container">
          <div class="note-area shadow p-3 rounded">
            <ul class="list-group" id="list-group">
                <% for (let post of postsList) { %>
                    <li class="list-group-item border rounded p-2 d-flex align-items-center gap-2 my-1"> 
                        <%= post.text %> 
                        <% if (post.creator !== username) { %>
                            <%- include("partials/vote.ejs", {post, username}) -%>
                        <% } %>
                        <span class="border-start p-1 ms-2">
                            <%= post.upvotes.length - post.downvotes.length %>
                        </span>
                    </li>
                <% } %>
            </ul>
            <%- include("partials/post.ejs", {username}) -%>
          </div>
        </div>
      </div>
    </div>
<%- include("layouts/footer.ejs") -%>

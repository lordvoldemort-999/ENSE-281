<%- include("layouts/header.ejs") -%>
    <div class="container px-5 py-5">
      <h1>Note-Vote</h1>
      <div class="accordion shadow" id="form-accordion">
        <div class="accordion-item">
          <h2 class="accordion-header">
            <button
              class="accordion-button"
              data-bs-toggle="collapse"
              data-bs-target="#collapseOne"
              aria-expanded="true"
              aria-controls="collapseOne"
              type="button"
              value="Log In"
            >
              Log In
            </button>
          </h2>
          <div
            id="collapseOne"
            class="accordion-collapse collapse show add-padding"
            data-bs-parent="#form-accordion"
          >
            <div class="accordion-body">
              <h2>Log In</h2>
              <form action="/login" method="post">
                <div class="input-div">
                  <label for="username" class="form-label">Email Address</label>
                  <input
                    type="email"
                    class="form-control"
                    name="username"
                    id="username"
                    placeholder="Email Address"
                  />
                </div>
                <div class="input-div">
                  <label for="password" class="form-label">Password</label>
                  <input
                    type="password"
                    class="form-control"
                    name="password"
                    id="email"
                    placeholder="Password"
                  />
                </div><br/>
                <div class="to-center">
                  <input type="submit" class="btn btn-primary" value="Log In"/>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="accordion-item">
          <h2 class="accordion-header">
            <button
              class="accordion-button"
              data-bs-toggle="collapse"
              data-bs-target="#collapseTwo"
              aria-expanded="true"
              aria-controls="collapseOne"
              type="button"
              value="Log In"
            >
              Register
            </button>
          </h2>
          <div
            id="collapseTwo"
            class="accordion-collapse collapse add-padding"
            data-bs-parent="#form-accordion"
          >
            <div class="accordion-body">
              <h2>Sign Up</h2>
              <form action="/register" method="post">
                <div class="input-div">
                  <label for="sign-up-username" class="form-label"
                    >Email Address</label
                  >
                  <input
                    type="email"
                    class="form-control"
                    name="username"
                    id="sign-up-username"
                    placeholder="Email Address"
                  />
                </div>
                <div class="input-div">
                  <label for="sign-up-password" class="form-label"
                    >Password</label
                  >
                  <input
                    type="password"
                    class="form-control"
                    name="password"
                    id="sign-up-password"
                    placeholder="Password"
                  />
                </div>
                <div class="input-div">
                  <label for="inv-code" class="form-label">Invite Code</label>
                  <input
                    type="text"
                    id="inv-code"
                    placeholder="Invite Code"
                    name="inviteCode"
                    class="form-control"
                  />
                </div><br/>
                <div class="to-center">
                  <input type="submit" class="btn btn-primary" value="Sign In"/>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
<%- include("layouts/footer.ejs") -%>
